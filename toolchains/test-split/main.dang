"""
Engine integration test groups.
"""
type TestSplit {
  """
  Workspace.
  """
  let ws: Workspace!

  """
  Engine integration test groups, keyed by their stable CI names.
  """
  pub groups: TestGroups! {
    TestGroups(
      ws: self.ws,
      names: [
        "base",
        "provision",
        "telemetry",
        "call-and-shell",
        "cli-engine",
        "cache-persistence",
        "local-cache",
        "client-generator",
        "container",
        "interface",
        "llm",
        "module-runtimes",
        "modules",
        "workspaces",
      ],
    )
  }

  """
  Lower-level API for running specific tests.
  """
  pub testSpecific(
    run: [String!]!,
    ebpfProgs: [String!],
    pkg: String! = "./core/integration",
    race: Boolean,
  ): Void {
    engineDev(ws: self.ws).test(race: race, run: run.join("|"), ebpfProgs: ebpfProgs, pkg: pkg)
  }
}

"""
A keyed set of engine integration test groups.
"""
type TestGroups @collection {
  """
  Stable group names in the default CI order.
  """
  pub names: [String!]! @keys

  let ws: Workspace!

  new(ws: Workspace!, names: [String!]!) {
    self.ws = ws
    self.names = names
    self
  }

  """
  Get one engine integration test group by name.
  """
  pub group(name: String!): TestGroup! @get {
    TestGroup(ws: self.ws, name: name)
  }
}

"""
One independently scheduled engine integration test group.
"""
type TestGroup {
  """
  Stable CI name of this group.
  """
  pub name: String!

  let ws: Workspace!

  new(ws: Workspace!, name: String!) {
    self.ws = ws
    self.name = name
    self
  }

  let testSpecific(
    run: [String!]!,
    ebpfProgs: [String!],
    pkg: String! = "./core/integration",
    race: Boolean,
  ): Void {
    engineDev(ws: self.ws).test(race: race, run: run.join("|"), ebpfProgs: ebpfProgs, pkg: pkg)
  }

  let testCliEngineSpecific(
    run: [String!]!,
    ebpfProgs: [String!],
    pkg: String! = "./core/integration",
    race: Boolean,
  ): Void {
    engineDev(ws: self.ws)
      .withEngineConfig("worker.oci", [
        "minFreeSpace = \"30%\"",
        "maxUsedSpace = \"50%\"",
      ].join("\n"))
      .test(race: race, run: run.join("|"), ebpfProgs: ebpfProgs, pkg: pkg)
  }

  let testSkip(
    skip: [String!]!,
    ebpfProgs: [String!],
    pkg: String! = "./core/integration",
    race: Boolean,
  ): Void {
    engineDev(ws: self.ws).test(race: race, skip: skip.join("|"), ebpfProgs: ebpfProgs, pkg: pkg)
  }

  """
  Run this test group.
  """
  pub test: Void @check {
    if (self.name == "base") {
      testSkip(
        # Keep this list exact so similarly named unit tests outside the integration
        # package remain in the base shard.
        skip: [
          "^TestCLI$",
          "^TestCachePersistence$",
          "^TestCall$",
          "^TestClientGenerator$",
          "^TestContainer$",
          "^TestDaggerCMD$",
          "^TestDockerfile$",
          "^TestElixir$",
          "^TestEngine$",
          "^TestGo$",
          "^TestInterface$",
          "^TestJava$",
          "^TestLLM$",
          "^TestLocalCache$",
          "^TestModule$",
          "^TestModuleConfig$",
          "^TestModuleLoading$",
          "^TestPHP$",
          "^TestProvision$",
          "^TestPython$",
          "^TestShell$",
          "^TestTelemetry$",
          "^TestTypescript$",
          "^TestWorkspace$",
          "^TestWorkspaceAPI$",
          "^TestWorkspaceCompat$",
          "^TestWorkspaceLegacyDefaultPath$",
          "^TestWorkspaceMigration$",
          "^TestWorkspaceModules$",
          "^TestWorkspaceSelection$",
        ],
        pkg: "./...",
        race: true,
      )
    } else if (self.name == "provision") {
      testSpecific(["TestProvision"])
    } else if (self.name == "telemetry") {
      testSpecific(["^TestTelemetry$"], pkg: "./dagql/idtui")
      testSpecific(["^TestTelemetry$"])
      null
    } else if (self.name == "call-and-shell") {
      testSpecific(["^TestCall$", "^TestShell$"])
      testSpecific(["^TestDaggerCMD$"], pkg: "./internal/cmd/dagger")
      null
    } else if (self.name == "cli-engine") {
      testCliEngineSpecific(["TestCLI", "TestEngine"])
    } else if (self.name == "cache-persistence") {
      testCliEngineSpecific(["TestCachePersistence"])
    } else if (self.name == "local-cache") {
      testCliEngineSpecific(["TestLocalCache"])
    } else if (self.name == "client-generator") {
      testSpecific(["TestClientGenerator"])
    } else if (self.name == "container") {
      testSpecific(["TestContainer", "TestDockerfile"])
    } else if (self.name == "interface") {
      testSpecific(["TestInterface"])
    } else if (self.name == "llm") {
      testSpecific(["TestLLM"])
    } else if (self.name == "module-runtimes") {
      testSpecific(["TestGo", "TestPython", "TestTypescript", "TestElixir", "TestPHP", "TestJava"])
    } else if (self.name == "modules") {
      testSpecific(["TestModule"])
    } else if (self.name == "workspaces") {
      testSpecific(["TestWorkspace"])
    } else {
      raise "unknown engine integration test group: " + self.name
    }
  }
}
