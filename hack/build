#!/usr/bin/env bash

# hack/build builds the engine and CLI from local code, and starts the engine
# in the host's container runtime.
#
# The work lives in the dev toolchain. This wrapper maps the historical
# _EXPERIMENTAL_* environment variables to its arguments and always runs from
# the repository root.
#
# Use a pinned bootstrap Dagger. It can load this v1.0 workspace independently
# of the Dagger version installed on the host, and it does not run on the dev
# engine that this command replaces.
X_RELEASE=${DAGGER_X_RELEASE:-00cb7d3a0e8d1eb6ec672aa504db14e52a9d1e21}

set -e -u -o pipefail

cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.."

# Build the CLI for the host, which can differ from the engine platform.
host_os=$(uname -s | tr '[:upper:]' '[:lower:]')
case "$(uname -m)" in
    x86_64 | amd64) host_arch=amd64 ;;
    aarch64 | arm64) host_arch=arm64 ;;
    *) host_arch=$(uname -m) ;;
esac

# --docker configures the Dev object, so it precedes the function name.
mod_args=()
if [[ -n "${DOCKER_HOST:-}" ]]; then
    mod_args+=(--docker="$DOCKER_HOST")
fi

args=(
    --name="${_EXPERIMENTAL_DAGGER_DEV_CONTAINER:-dagger-engine.dev}"
    --image="${_EXPERIMENTAL_DAGGER_DEV_IMAGE:-localhost/dagger-engine.dev}"
    --platform="$host_os/$host_arch"
)

if [[ -n "${_EXPERIMENTAL_DAGGER_GPU_SUPPORT:-}" ]]; then
    args+=(--gpu-support)
fi
if [[ -n "${DAGGER_EXTRA_HOSTS:-}" ]]; then
    args+=(--extra-hosts="$DAGGER_EXTRA_HOSTS")
fi
if [[ -n "${DAGGER_CLOUD_TOKEN:-}" ]]; then
    args+=(--cloud-token=env://DAGGER_CLOUD_TOKEN)
fi
if [[ -n "${DAGGER_CLOUD_URL:-}" ]]; then
    args+=(--cloud-url="$DAGGER_CLOUD_URL")
fi

exec dagger --x-release "$X_RELEASE" \
    api call dev "${mod_args[@]+"${mod_args[@]}"}" deploy "${args[@]}" --output ./bin
