#!/usr/bin/env bash

# hack/dev builds and starts a dev environment, then runs the requested command
# in that environment.

set -e -u

export HACK="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"

# Dagger modules cannot read the active Docker context directly.
export DOCKER_HOST=${DOCKER_HOST:-$(docker context inspect -f '{{.Endpoints.docker.Host}}')}

# Build from the repository root so dagger.toml is always discovered. Keep the
# caller's directory for the command run by with-dev.
(cd "$HACK/.." && "$HACK/build")
"$HACK/with-dev" "$@"
